# Sao file này thành .env cho chạy cục bộ. Không commit .env hoặc khóa thật.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=30000
# Bước viết cần xuất cả lời đọc và bằng chứng nên có timeout riêng.
LLM_GENERATE_TIMEOUT_MS=120000
LLM_CONCURRENCY=4
LLM_MIN_GAP_MS=0
LLM_MAX_RETRY=1
LLM_RETRY_CAP_MS=30000
TAVILY_API_KEY=
# Tài khoản demo được điền sẵn trên trang đăng nhập. Đổi mật khẩu khi triển khai.
TEACHER_EMAIL=giangvien@gmail.com
TEACHER_PASSWORD=GiangVien@2026
STUDENT_EMAIL=hocsinh@gmail.com
STUDENT_PASSWORD=HocSinh@2026
# Bắt buộc trên Vercel; dùng chuỗi ngẫu nhiên dài để ký cookie đăng nhập.
AUTH_SESSION_SECRET=
SCRAPE_TIMEOUT_MS=12000
SCRAPE_MAX_CHARS=12000
# PROJECTS_DIR=D:/path/to/projects
# FEEDBACK_DIR=D:/path/to/feedback
# LLM_TRACE=1

# Vercel: private Blob store tự cấp BLOB_READ_WRITE_TOKEN cho project.
# Không đặt token đó trong file này.
