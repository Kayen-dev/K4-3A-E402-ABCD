# ══════════════════════════════════════════════════════════════════════
#  FILE MẪU — hệ thống KHÔNG đọc file này.
#
#  Phải copy thành .env mới có tác dụng:
#      Copy-Item codebase\.env.example codebase\.env
#
#  Rồi mở codebase\.env, điền khoá vào dòng LLM_API_KEY.
#  .env đã nằm trong .gitignore nên không bị commit. File .example NÀY thì
#  ĐƯỢC commit — tuyệt đối không để khoá thật ở đây.
#
#  Kiểm tra:  node codebase/kiem-tra-khoa.js
#
#  TOÀN BỘ cấu hình gọi API nằm trong file này. Không có giá trị nào phải
#  sửa trong code. Biến môi trường đặt sẵn ($env: trong PowerShell) THẮNG
#  giá trị ở đây.
# ══════════════════════════════════════════════════════════════════════

# ─── Bắt buộc ───────────────────────────────────────────────────────

# gemini | anthropic | openai | openrouter | stub
#   stub       = chạy bằng đáp án dựng sẵn trong fixtures/llm/, không cần mạng,
#                không tốn hạn mức. Dùng cho eval và khi demo không có wifi.
#   openrouter = một khoá đi được nhiều model, có cả model :free. Dùng khi
#                free tier của Gemini (5 request/phút) không đủ cho một lượt
#                chạy 13 lời gọi.
LLM_PROVIDER=gemini

# ĐIỀN KHOÁ VÀO ĐÂY, sau dấu = , không cần dấu nháy
LLM_API_KEY=


# ─── Model ──────────────────────────────────────────────────────────

# Ghi đè model của nhà đang dùng. Để trống thì lấy theo ba dòng dưới.
# LLM_MODEL=

# Google ngừng model cũ khá thường xuyên. Gặp 404 thì hệ thống in ra đúng
# tên model thay thế — sửa dòng tương ứng là xong, không phải sửa code.
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o-mini

# OpenRouter. "openrouter/free" là bộ định tuyến sang model miễn phí đang rảnh —
# CHẠY ĐƯỢC, nhưng chậm: đo thực tế ~18 giây mỗi lời gọi, vì model free bị xếp
# hàng chung với tất cả mọi người. Một lượt 13 lời gọi mất 1–4 phút.
#
# Muốn nhanh thì chỉ đích danh một model trả phí rẻ, ví dụ:
#     OPENROUTER_MODEL=openai/gpt-4o-mini
#     OPENROUTER_MODEL=google/gemini-2.5-flash
# Danh sách và giá: https://openrouter.ai/models
# Gặp 400/404 là ID sai hoặc model đã bị gỡ — hệ thống in kèm link đó trong lỗi.
OPENROUTER_MODEL=openrouter/free


# ─── Tham số gọi ────────────────────────────────────────────────────

# 0.2 — thấp, vì cả bốn lời gọi đều là việc phán đoán theo tiêu chí, không
# phải việc sáng tạo. Để cao hơn thì hai lượt chạy ra kết quả khác nhau, và
# tiêu chí "chạy lại cho kết quả tương đương" (10%) sẽ mất điểm.
LLM_TEMPERATURE=0.2

LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=30000


# ─── Hạn mức (rate limit) ───────────────────────────────────────────
#
# Một lượt chạy 12 nguồn gọi model tới 13 lần. Free tier Gemini cho 5 lần
# mỗi phút, nên chạy thẳng là chắc chắn dính lỗi 429 giữa chừng.
#
# LLM_MIN_GAP_MS: khoảng cách tối thiểu giữa hai lời gọi, tính bằng ms.
#   0     = không giãn (dùng khi có trả phí, hoặc khi chạy stub)
#   13000 = an toàn cho free tier Gemini 5 req/phút — một lượt mất ~3 phút
#   3500  = đủ cho model :free của OpenRouter (20 req/phút)
LLM_MIN_GAP_MS=0

# Số nguồn chấm SONG SONG. Các nguồn độc lập nhau nên không cần nối tiếp.
#   4 = mặc định. Model free ~18s mỗi lời gọi: 10 nguồn nối tiếp mất 3 phút,
#       4 luồng còn dưới 1 phút.
#   1 = nối tiếp, dùng khi nhà cung cấp chặn gọi đồng thời.
# LƯU Ý: đặt LLM_MIN_GAP_MS > 0 thì hệ thống tự xếp hàng lại, và biến này
# mất tác dụng — hai thứ đó loại trừ nhau.
LLM_CONCURRENCY=4

# Dính 429 thì chờ đúng số giây API bảo chờ rồi thử lại, tối đa mấy lần.
LLM_MAX_RETRY=3

# Trần thời gian chờ mỗi lần thử lại (ms) — để không treo cứng lúc demo.
LLM_RETRY_CAP_MS=65000


# ─── Endpoint — chỉ đổi khi dùng proxy hoặc API tương thích ─────────

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hai header OpenRouter dùng để hiện tên ứng dụng trên bảng xếp hạng của họ.
# Không bắt buộc. Điền link repo của nhóm nếu muốn.
OPENROUTER_REFERER=https://github.com/
OPENROUTER_TITLE=ScriptScout (AI20k nhom 3A)


# ─── Tải trang web ──────────────────────────────────────────────────

SCRAPE_TIMEOUT_MS=12000

# Cắt nội dung mỗi trang ở bao nhiêu ký tự trước khi đưa vào prompt AI 2.
# Đây là tham số CHI PHÍ: tăng lên thì tốn token theo tỉ lệ thuận, vì AI 2
# được gọi một lần cho MỖI nguồn đọc được.
SCRAPE_MAX_CHARS=12000

SCRAPE_USER_AGENT=ScriptScout/1.0 (hackathon AI20k; nhom 3A)


# ─── Máy chủ ────────────────────────────────────────────────────────

PORT=5173


# ══════════════════════════════════════════════════════════════════════
#  KHÔNG cấu hình được ở đây, và có lý do:
#
#    ngưỡng 18 tháng (nguồn quá hạn)   -> src/rules.js
#    ngưỡng 25 âm tiết (câu quá dài)   -> src/rules.js
#    quality bar 80%                   -> eval/golden_set.json
#
#  Ba con số đó là chuẩn chấm đã chốt trong spec.md tại CP4. Để .env đổi
#  được thì ai cũng sửa được chuẩn, và bảng kết quả hai lượt không còn so
#  sánh được với nhau.
# ══════════════════════════════════════════════════════════════════════
