# Sao file này thành .env cho chạy cục bộ. Không commit .env hoặc khóa thật.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=30000
LLM_CONCURRENCY=4
LLM_MIN_GAP_MS=0
LLM_MAX_RETRY=1
LLM_RETRY_CAP_MS=30000
TAVILY_API_KEY=
SCRAPE_TIMEOUT_MS=12000
SCRAPE_MAX_CHARS=12000
# PROJECTS_DIR=D:/path/to/projects
# LLM_TRACE=1

# Vercel: private Blob store tự cấp BLOB_READ_WRITE_TOKEN cho project.
# Không đặt token đó trong file này.
