{
  "version": 2,
  "framework": null,
  "buildCommand": "npm --prefix ui install && npm --prefix ui run build",
  "outputDirectory": "ui/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": { "api/index.js": { "maxDuration": 60 } }
}
